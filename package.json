{
    "name": "tarot-journal-workspace",
    "private": true,
    "scripts": {
        "dev": "concurrently -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:backend": "cd backend && uv run python -X utf8 -m fastapi dev main.py",
        "dev:frontend": "cd frontend && npm run dev"
    },
    "devDependencies": {
        "concurrently": "^9.1.2"
    }
}